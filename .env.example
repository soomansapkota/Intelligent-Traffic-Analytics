# Postgres connection. Defaults below match docker-compose.yml; override
# DATABASE_URL directly to point at a managed instance instead.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=traffic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Kafka broker, used by --publish and the stream processor. Only needed for
# the streaming path -- the pipeline and dataset build work without it.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=metro
KAFKA_GROUP_ID=traffic-analytics
