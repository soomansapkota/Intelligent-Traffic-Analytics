# Environment / secrets
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data (never commit the local database or other generated data)
data/*
!data/.gitkeep

# Trained models and metrics (regenerate with `python -m src.modeling.train`)
models/*
!models/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
