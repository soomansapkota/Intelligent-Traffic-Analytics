<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F7F5"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#123B36"
        android:padding="20dp"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYDNEY METRO  /  NETWORK OPERATIONS"
            android:textColor="#A7D7C5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Traffic overview"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Live service alerts and network conditions"
            android:textColor="#D2E2DC"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:weightSum="3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAlerts"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Alerts"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:backgroundTint="#176B5B"
            app:cornerRadius="8dp"
            app:insetTop="0dp"
            app:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDelays"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:text="Delays"
            android:textAllCaps="false"
            android:textColor="#24433C"
            android:textSize="13sp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="8dp"
            app:strokeColor="#D6E2DD"
            app:strokeWidth="1dp"
            app:insetTop="0dp"
            app:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonVehicles"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Vehicles"
            android:textAllCaps="false"
            android:textColor="#24433C"
            android:textSize="13sp"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="8dp"
            app:strokeColor="#D6E2DD"
            app:strokeWidth="1dp"
            app:insetTop="0dp"
            app:insetBottom="0dp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAlerts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
