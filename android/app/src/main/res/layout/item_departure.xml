<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeColor="#DCE6E1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- e.g. "18:48 → 19:25" -->
            <TextView
                android:id="@+id/textViewTimes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#173B35"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- e.g. "5 mins" -->
            <TextView
                android:id="@+id/textViewCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#176B5B"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- e.g. "To Tallawong · 37 min trip" -->
            <TextView
                android:id="@+id/textViewDestination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#24433C"
                android:textSize="13sp" />

            <!-- "On time", "Late · 3 mins", "Early · 1 min" or "Scheduled"; colour set in DepartureAdapter -->
            <TextView
                android:id="@+id/textViewPunctuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- e.g. "Timetabled 18:45" when the expected time differs -->
        <TextView
            android:id="@+id/textViewScheduled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#697873"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- e.g. "Now at Victoria Cross Station" -->
        <TextView
            android:id="@+id/textViewPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#24433C"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- e.g. "Now: 2 mins late · Predicted: 3 mins late" or "Timetable only" -->
        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
